# Native modules are built for Electron's runtime, not for whatever Node you
# happen to have installed. With these set, npm downloads the prebuilt
# better-sqlite3 binary for Electron rather than invoking node-gyp, so a newer
# local Node (which better-sqlite3 cannot compile against) is harmless.
#
# npm 11+ warns "Unknown project config" about these. The warning is harmless:
# they are consumed by node-gyp and prebuild-install, not by npm itself. That
# npm version also blocks dependency install scripts by default, which is why
# `predev`/`pretest` provision the binaries directly via scripts/ensure-native.mjs
# instead of trusting install hooks.
#
# Keep `target` in step with the electron version in package.json.
runtime = electron
target = 32.3.3
disturl = https://electronjs.org/headers
build_from_source = false
